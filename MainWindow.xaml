<Window x:Class="GpuReduct.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GpuReduct.Controls"
        Title="GPU Reduct" Width="820" Height="560"
        Icon="/Assets/GpuReduct.ico"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding CleanCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ───── Title bar ───── -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="GPU Reduct" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Margin="12,0" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>

                    <!-- GPU picker: pill + dropdown list -->
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton x:Name="AdapterToggle" ToolTip="Select GPU">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
                                    <Style.Triggers>
                                        <!-- While open, a click on the pill should only close the popup (not reopen it) -->
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=AdapterPopup}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding AdapterName}" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="8,1,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <Popup x:Name="AdapterPopup" PlacementTarget="{Binding ElementName=AdapterToggle}"
                               Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=AdapterToggle, Mode=TwoWay}">
                            <Border Style="{StaticResource MenuPanel}" MinWidth="260">
                                <StackPanel>
                                    <TextBlock Text="Graphics adapters" Style="{StaticResource Caption}" Margin="10,6,10,6"/>
                                    <ListBox Style="{StaticResource MenuList}" ItemContainerStyle="{StaticResource MenuListItem}"
                                             ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                             PreviewMouseLeftButtonUp="AdapterList_PreviewMouseLeftButtonUp"
                                             KeyDown="AdapterList_KeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                        <TextBlock Text="{Binding VramText, StringFormat='{}{0} dedicated'}"
                                                                   Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Check" Grid.Column="1" Text="&#xE73E;" FontSize="12"
                                                               FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentHoverBrush}"
                                                               VerticalAlignment="Center" Margin="16,0,2,0" Visibility="Hidden"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" Margin="4,0,0,0"
                            ToolTip="Hide to tray" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ───── Content ───── -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero: dedicated VRAM -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Dedicated video memory" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                            <TextBlock Text="{Binding UsedText}" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalText, StringFormat='/ {0}'}" FontSize="15"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                        </StackPanel>

                        <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource UsageBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="Warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="Critical">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <controls:Sparkline Height="72" Margin="0,20,0,0" Maximum="100"
                                            Values="{Binding History}" Stroke="{StaticResource AccentBrush}"/>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="60s ago" Style="{StaticResource Caption}"/>
                            <TextBlock Text="now" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shared memory" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding SharedText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPU load" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding LoadText}" Style="{StaticResource StatValue}"/>
                            <ProgressBar Style="{StaticResource UsageBar}" Height="3" Margin="0,10,0,0"
                                         Value="{Binding LoadPercent, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPU processes" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Actions -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource PrimaryButton}" Height="38" Command="{Binding CleanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Clean memory" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Kbd}">
                                <TextBlock Text="Ctrl ↵" FontSize="11" Foreground="#CCFFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="38"
                            Command="{Binding ResetDriverCommand}" ToolTip="Restart the graphics driver (Win+Ctrl+Shift+B)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Reset driver" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="2,12,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top consumers -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <TextBlock Text="Top consumers" FontWeight="Medium"/>
                                <TextBlock Text="VRAM" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1" Text="No processes are using this GPU"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Processes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Processes}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="10,8" CornerRadius="6" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Pid}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding DedicatedText}" FontSize="12" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <Button x:Name="KillBtn" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource IconButton}"
                                                    Width="22" Height="22" Margin="8,0,0,0" Content="&#xE711;" ToolTip="End process"
                                                    Visibility="Hidden"
                                                    Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Pid}"/>

                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource UsageBar}" Height="2"
                                                         Margin="0,8,0,0" Opacity="0.8" Value="{Binding SharePercent, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="KillBtn" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Auto clean -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto clean" IsChecked="{Binding AutoCleanEnabled}"/>
                            <TextBlock Text="{Binding AutoCleanThreshold, StringFormat='at {0}%'}" Style="{StaticResource Label}"
                                       FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Style="{StaticResource LinearSlider}" Margin="0,14,0,0"
                                Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding AutoCleanThreshold}" IsEnabled="{Binding AutoCleanEnabled}"/>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   Text="Trims GPU processes when VRAM crosses the threshold. Runs at most once a minute."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
